aws_region                = "eu-north-1"
environment               = "dev"
# Locally: provide immutable image pins with TF_VAR_docker_image / TF_VAR_worker_image.
enable_ecs                = true
enable_rds                = true
rds_instance_class        = "db.t4g.micro"
rds_allocated_storage     = 20
ecs_worker_desired_count  = 1
ecs_assign_public_ip      = false
vpc_cidr                  = "10.0.0.0/16"
public_subnet_cidrs       = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs      = ["10.0.101.0/24", "10.0.102.0/24"]

# Optional TLS: validated ACM cert ARN (same region as alb). Unset = HTTP-only demo (port 80).
# alb_certificate_arn     = "arn:aws:acm:eu-north-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
